+	[MethodImpl(MethodImplOptions.AggressiveInlining)]
+	private static unsafe Vector512<int> Gather256Pair(int* pPalette, Vector256<int> zero, Vector256<int> palLenVec, Vector512<int> idx)
+	{
+		Vector256<int> lo = idx.GetLower();
+		Vector256<int> hi = idx.GetUpper();
+		Vector256<int> rlo = Avx2.GatherMaskVector256(zero, pPalette, lo, Avx2.CompareGreaterThan(palLenVec, lo), 4);
+		Vector256<int> rhi = Avx2.GatherMaskVector256(zero, pPalette, hi, Avx2.CompareGreaterThan(palLenVec, hi), 4);
+		return Vector512.Create(rlo, rhi);
+	}
