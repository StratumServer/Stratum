+        // Stratum start: watchdog and instant settle
+        private void StratumServerWatchdog(ModSystemFallingBlocks stratumSystem)
+        {
+            if (!Alive) return;
+
+            // Entities that do not remove their source block (coal pile TryPartialCollapse) split a block
+            // that stays in place, so they rely on the vanilla lifecycle. BlockEntityCoalPile itself is not
+            // visible from this assembly, DoRemoveBlock identifies the same case.
+            if (!DoRemoveBlock) return;
+
+            long now = World.ElapsedMilliseconds;
+
+            int timeout = stratumSystem.StuckTimeoutMs;
+            if (timeout > 0 && now - StratumSpawnTimeMs > timeout)
+            {
+                // Stuck next to a player: settle where the block hangs.
+                StratumSettleAt(Pos.AsBlockPos);
+                return;
+            }
+
+            if (now - StratumLastPlayerCheckMs < StratumPlayerCheckIntervalMs) return;
+            StratumLastPlayerCheckMs = now;
+
+            // No player nearby: resolve the fall instantly.
+            if (!stratumSystem.HasPlayerNearby(Pos.XYZ))
+            {
+                StratumSettleAt(initialPos);
+            }
+        }
+
+        private bool stratumSettleQueued;
+
+        private void StratumSettleAt(BlockPos atPos)
+        {
+            if (fallHandled || stratumSettleQueued) return;
+            stratumSettleQueued = true;
+            BlockPos at = atPos.Copy();
+
+            Api.Event.EnqueueMainThreadTask(() =>
+            {
+                stratumSettleQueued = false;
+                // The entity may have landed meanwhile, or despawned (an Unload is left to vanilla, then OnEntityDespawn settles it).
+                if (fallHandled || !Alive || State == EnumEntityState.Despawned) return;
+                fallHandled = true;
+
+                try
+                {
+                    if (!InitialBlockRemoved)
+                    {
+                        InitialBlockRemoved = true;
+                        UpdateBlock(true, initialPos);
+                    }
+
+                    ModSystemFallingBlocks.SimulateInstantFall(
+                        World, Block, Block, removedBlockentity, blockEntityAttributes,
+                        at, drops, false);
+                }
+                catch (Exception e)
+                {
+                    try { Api.Logger.Warning("[Stratum] Falling entity settle failed at {0}: {1}", at, e.Message); }
+                    catch { /* logger may already be torn down */ }
+                }
+                finally
+                {
+                    Die(EnumDespawnReason.Removed);
+                }
+            }, "StratumFallingSettle");
+        }
+        // Stratum end
+
