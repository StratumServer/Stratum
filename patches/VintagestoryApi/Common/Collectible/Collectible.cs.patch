+        // Stratum: Bound repeated behavior failures to one log per collectible, callback, and behavior type.
+        private System.Collections.Concurrent.ConcurrentDictionary<(Type BehaviorType, string Callback), byte> StratumLoggedBehaviorExceptions;
+
+        private void StratumLogBehaviorException(ILogger StratumLogger, CollectibleBehavior StratumBehavior, Exception StratumException, string StratumCallback)
+        {
+            if (StratumLogger == null) return;
+
+            Type StratumBehaviorType = StratumBehavior?.GetType() ?? typeof(CollectibleBehavior);
+            System.Collections.Concurrent.ConcurrentDictionary<(Type BehaviorType, string Callback), byte> StratumLoggedExceptions =
+                System.Threading.LazyInitializer.EnsureInitialized(ref StratumLoggedBehaviorExceptions);
+            if (!StratumLoggedExceptions.TryAdd((StratumBehaviorType, StratumCallback), 0)) return;
+
+            StratumLogger.Error("Exception thrown in CollectibleBehavior {0} during {1} for {2}:", StratumBehaviorType.FullName, StratumCallback, Code);
+            StratumLogger.Error(StratumException);
+        }
