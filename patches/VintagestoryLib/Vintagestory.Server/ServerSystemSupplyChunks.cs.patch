+	/// <summary>
+	/// Publishes the freshly built priority list for the dispatcher and
+	/// returns it for the chunk thread's own consumption.
+	/// </summary>
+	private List<ChunkColumnLoadRequest> PublishPriorityList(List<ChunkColumnLoadRequest> list)
+	{
+		Volatile.Write(ref stratumPriorityListPublished, list);
+		return list;
+	}
