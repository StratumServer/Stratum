+	/// <summary>
+	/// Dispatcher: scans the request queue and sends ready tasks to the worker channel.
+	/// Returns true if at least one task was dispatched.
+	/// </summary>
+	private bool ScheduleReadyTasks()
+	{
+		if (!Monitor.TryEnter(dispatcherLock)) return false;
+		try
+		{
+			if (pauseAllWorldgenThreads > 0) return false;
+			if (dispatcherShuttingDown || server.stopped) return false;
+			if (chunkthread.requestedChunkColumns.Count == 0) return false;
+
+			// With every worker stage claimed, no request in the queue is
+			// dispatchable. Skip the O(N) scan; a stage release signals us.
+			if (!AnyWorkerStageFree()) return false;
+
+			int dispatched = 0;
+
+			try
+			{
+				// Near-player columns first. The chunk thread publishes this
+				// list once per tick; iterate a snapshot by index, since the
+				// buffer it points at stays intact for at least a full tick
+				// and TryDispatchRequest re-validates every entry anyway.
+				List<ChunkColumnLoadRequest> prioritized = Volatile.Read(ref stratumPriorityListPublished);
+				if (prioritized != null)
+				{
+					for (int i = 0; i < prioritized.Count; i++)
+					{
+						if (TryDispatchRequest(prioritized[i])) dispatched++;
+
+						// Every worker stage claimed: nothing further can dispatch
+						if (!AnyWorkerStageFree()) return dispatched > 0;
+					}
+				}
+
+				// FIFO scan for everything the priority pass did not cover
+				foreach (var req in chunkthread.requestedChunkColumns)
+				{
+					if (TryDispatchRequest(req)) dispatched++;
+
+					// Every worker stage claimed: nothing further in this scan
+					// can dispatch, stop iterating the remainder of the queue
+					if (!AnyWorkerStageFree()) break;
+				}
+			}
+			catch (InvalidOperationException) when (!readyTasksQueue.IsAddingCompleted)
+			{
+				// Collection was modified during iteration - normal, will retry next tick
+			}
+			catch (InvalidOperationException)
+			{
+				// Channel completed (CompleteAdding) - exit
+				return false;
+			}
+
+			return dispatched > 0;
+		}
+		catch (Exception ex)
+		{
+			ServerMain.Logger.Error("Dispatcher error: " + ex);
+			return false;
+		}
+		finally
+		{
+			Monitor.Exit(dispatcherLock);
+		}
+	}
