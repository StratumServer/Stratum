+	private static Vector256<byte>[] MakePackCtl()
+	{
+		// For plane k: byte g of the word's plane (block group g) is placed into byte k
+		// of the 64-bit lane g. vpshufb indexes bytes INSIDE a 128-bit half:
+		// upper half takes bytes 2,3 from its source (groups 2,3).
+		var res = new Vector256<byte>[8];
+		for (int k = 0; k < 8; k++)
+		{
+			byte[] b = new byte[32];
+			for (int i = 0; i < 32; i++) b[i] = 0x80;
+			b[k] = 0x00; b[8 + k] = 0x01;        // lower half: groups 0,1.
+			b[16 + k] = 0x02; b[24 + k] = 0x03;  // upper half: groups 2,3.
+			res[k] = Vector256.Create(b);
+		}
+		return res;
+	}
+
+	private static Vector256<byte> MakeExtractCtl()
+	{
+		// After transpose: byte j of each 64-bit lane g is the low byte of block index
+		// g*8+j. Distribute 8 bytes of lane g across eight 32-bit lanes.
+		byte[] b = new byte[32];
+		for (int i = 0; i < 32; i++) b[i] = 0x80;
+		for (int i = 0; i < 4; i++)
+		{
+			b[4 * i] = (byte)i;             // lower half: blocks 0..3.
+			b[16 + 4 * i] = (byte)(4 + i);  // upper half: blocks 4..7.
+		}
+		return Vector256.Create(b);
+	}
+
+	/// <summary>8x8 bit transpose within each of four 64-bit lanes (Hacker's Delight).</summary>
+	[MethodImpl(MethodImplOptions.AggressiveInlining)]
+	private static Vector256<ulong> Transpose8x8(Vector256<ulong> x)
+	{
+		Vector256<ulong> t;
+		t = Avx2.And(Avx2.Xor(x, Avx2.ShiftRightLogical(x, 7)), Vector256.Create(0x00AA00AA00AA00AAUL));
+		x = Avx2.Xor(x, Avx2.Xor(t, Avx2.ShiftLeftLogical(t, 7)));
+		t = Avx2.And(Avx2.Xor(x, Avx2.ShiftRightLogical(x, 14)), Vector256.Create(0x0000CCCC0000CCCCUL));
+		x = Avx2.Xor(x, Avx2.Xor(t, Avx2.ShiftLeftLogical(t, 14)));
+		t = Avx2.And(Avx2.Xor(x, Avx2.ShiftRightLogical(x, 28)), Vector256.Create(0x00000000F0F0F0F0UL));
+		x = Avx2.Xor(x, Avx2.Xor(t, Avx2.ShiftLeftLogical(t, 28)));
+		return x;
+	}
+
+	/// <summary>Extracts group g (blocks g*8..g*8+7) from the transposed register as 8x32-bit lane (low byte = index).</summary>
+	[MethodImpl(MethodImplOptions.AggressiveInlining)]
+	private static Vector256<int> ExtractGroup(Vector256<ulong> t, int g)
+	{
+		Vector256<byte> rep = Avx2.Permute4x64(t.AsInt64(), (byte)(g * 0x55)).AsByte();
+		return Avx2.Shuffle(rep, ExtractCtl).AsInt32();
+	}
