+	/// <summary>
+	/// Generation worker loop. Takes tasks from the channel and processes the chunk
+	/// through all available stages in a pipeline until it hits an occupied stage.
+	/// </summary>
+	public void GeneratorThreadLoop()
+	{
+		Thread.Sleep(5);
+		while (!server.stopped && !dispatcherShuttingDown)
+		{
+			// Check if pause is required
+			PauseWorldgenThreadIfRequired(onChunkthread: false);
+
+			if (pauseAllWorldgenThreads > 0)
+			{
+				Thread.Sleep(15);
+				continue;
+			}
+
+			DispatchedTask task = default;
+			ChunkColumnLoadRequest request = null;
+			int currentStage = -1;
+			bool holdingStage = false;
+
+			try
+			{
+				try
+				{
+					// Take a task from the channel with 100ms timeout for periodic pause checks
+					if (!readyTasksQueue.TryTake(out task, 100))
+					{
+						if (readyTasksQueue.IsCompleted || dispatcherShuttingDown || server.stopped)
+						{
+							break;
+						}
+						continue;
+					}
+				}
+				catch (InvalidOperationException)
+				{
+					continue; // Channel is closed
+				}
+
+				request = task.Request;
+				currentStage = task.ClaimedStage; // ← stage from the dispatcher, do NOT re-read
+
+				// Safety check: the request may have advanced while sitting in the queue
+				if (request.CurrentIncompletePass_AsInt != currentStage)
+				{
+					Interlocked.Decrement(ref stratumStageActiveCount[currentStage]);
+					Volatile.Write(ref request.dispatchClaimed, 0);
+					SignalDispatcher(); // wake the dispatcher
+					continue; // not holding — skip finally with holdingStage
+				}
+
+				holdingStage = true;
+
+
+				try
+				{
+					PopulateChunk(request);
+				}
+				catch (Exception ex)
+				{
+					ServerMain.Logger.Error("PopulateChunk error at stage " + currentStage + ": " + ex);
+				}
+
+
+			}
+			catch (Exception ex) when (ex is not OperationCanceledException)
+			{
+				ServerMain.Logger.Error("Worker thread error: " + ex);
+			}
+			finally
+			{
+				if (holdingStage && currentStage >= 0 && currentStage < stratumStageActiveCount.Length)
+				{
+					Interlocked.Decrement(ref stratumStageActiveCount[currentStage]);
+					Volatile.Write(ref request.dispatchClaimed, 0);
+					SignalDispatcher(); // wake the dispatcher
+				}
+			}
+		}
+
+		// Release thread-local generation resources
+		BlockAccessorWorldGen.ThreadDispose();
+	}
