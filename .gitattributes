# Keep patch files as LF so `git apply` always sees what extract-patches.ps1 wrote.
# Unified diff context markers put one required space before tab-indented source.
patches/**/*.patch text eol=lf whitespace=-space-before-tab
*.ps1 text eol=crlf
*.cs text eol=lf
*.csproj text eol=lf
*.slnx text eol=lf
*.json text eol=lf
