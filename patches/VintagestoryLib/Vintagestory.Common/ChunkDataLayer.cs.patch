+			if (num <= 8)
+			{
+				// Specialized path for bitsize <= 8.
+				for (; word + 1 < 1024; word += 2)
+				{
+					int uniIdx0;
+					int mixed0 = LoadWordsAndClassify(w, planes, num, word, out uniIdx0);
+					DecodeWordAvx2_LE8(w, num, pPalette, palLen, pOut + outIdx, mixed0, uniIdx0);
+					outIdx += 32;
+
+					int uniIdx1;
+					int mixed1 = LoadWordsAndClassify(w, planes, num, word + 1, out uniIdx1);
+					DecodeWordAvx2_LE8(w, num, pPalette, palLen, pOut + outIdx, mixed1, uniIdx1);
+					outIdx += 32;
+				}
+				if (word < 1024)
+				{
+					int uniIdx;
+					int mixed = LoadWordsAndClassify(w, planes, num, word, out uniIdx);
+					DecodeWordAvx2_LE8(w, num, pPalette, palLen, pOut + outIdx, mixed, uniIdx);
+				}
+			}
+			else
+			{
+				// General path for bitsize > 8 (original code).
+				for (; word + 1 < 1024; word += 2)
+				{
+					int uniIdx0;
+					int mixed0 = LoadWordsAndClassify(w, planes, num, word, out uniIdx0);
+					DecodeWordAvx2(w, num, pPalette, palLen, pOut + outIdx, mixed0, uniIdx0);
+					outIdx += 32;
+
+					int uniIdx1;
+					int mixed1 = LoadWordsAndClassify(w, planes, num, word + 1, out uniIdx1);
+					DecodeWordAvx2(w, num, pPalette, palLen, pOut + outIdx, mixed1, uniIdx1);
+					outIdx += 32;
+				}
+				if (word < 1024)
+				{
+					int uniIdx;
+					int mixed = LoadWordsAndClassify(w, planes, num, word, out uniIdx);
+					DecodeWordAvx2(w, num, pPalette, palLen, pOut + outIdx, mixed, uniIdx);
+				}
+			}
+		}
+	}
