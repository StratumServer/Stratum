+	/// <summary>
+	/// Loads plane words into w and classifies the word.
+	/// Optimization: uses direct access via MemoryMarshal.GetArrayDataReference,
+	/// without null check or array bounds checking.
+	/// </summary>
+	[MethodImpl(MethodImplOptions.AggressiveInlining)]
+	private static unsafe int LoadWordsAndClassify(int* w, int[][] planes, int num, int word, out int uniIdx)
+	{
+		int mixed = 0;
+		uniIdx = 0;
+		for (int k = 0; k < num; k++)
+		{
+			int[] plane = planes[k];
+			// Guaranteed that plane != null for k < num.
+			ref int baseRef = ref MemoryMarshal.GetArrayDataReference(plane);
+			int v = Unsafe.Add(ref baseRef, word);
+			w[k] = v;
+			mixed |= v ^ (v >> 31);          // != 0 only if v is not 0 and not -1.
+			if (v != 0) uniIdx |= 1 << k;
+		}
+		return mixed;
+	}
+
+	/// <summary>
+	/// Decodes a single word (32 blocks) for bitsize <= 8.
+	/// Simplified version of DecodeWordAvx2 without handling the upper 8 planes.
+	/// </summary>
+	[MethodImpl(MethodImplOptions.AggressiveInlining)]
+	private static unsafe void DecodeWordAvx2_LE8(
+		int* w, int num, int* pPalette, int palLen, int* pOut, int mixed, int uniIdx)
+	{
+		// Fast path: all planes are 0 or -1.
+		if (mixed == 0)
+		{
+			uint ui = (uint)uniIdx;
+			int val = ui < (uint)palLen ? pPalette[ui] : 0;
+			Vector256<int> z = Vector256.Create(val);
+			Unsafe.WriteUnaligned(pOut, z);
+			Unsafe.WriteUnaligned(pOut + 8, z);
+			Unsafe.WriteUnaligned(pOut + 16, z);
+			Unsafe.WriteUnaligned(pOut + 24, z);
+			return;
+		}
+
+		// Pack byte groups of 8 planes (num <= 8).
+		Vector256<byte> P = Vector256<byte>.Zero;
+		for (int k = 0; k < num; k++)
+		{
+			int v = w[k];
+			if (v == 0) continue;
+			P = Avx2.Or(P, Avx2.Shuffle(Vector256.Create(v).AsByte(), PackCtl[k]));
+		}
