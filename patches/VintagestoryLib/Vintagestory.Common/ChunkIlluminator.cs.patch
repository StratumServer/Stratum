+	/// <summary>
+	/// Universal calculation of effective light absorption by a block for a given ray direction.
+	/// </summary>
+	[MethodImpl(MethodImplOptions.AggressiveInlining)]
+	private int GetEffectiveAbsorption(
+		Block block,
+		int baseAbsorption,
+		BlockFacing dir,
+		float incomingEnergy,
+		BlockPos pos = null)
+	{
+		// Stage 0: fully transparent — no absorption at all
+		if (baseAbsorption <= 0)
+			return 0;
+
+		// Stage 1: build the solidity mask (one bit per face)
+		int solidMask = 0;
+		if (block.SideSolid[0]) solidMask |= 1;
+		if (block.SideSolid[1]) solidMask |= 2;
+		if (block.SideSolid[2]) solidMask |= 4;
+		if (block.SideSolid[3]) solidMask |= 8;
+		if (block.SideSolid[4]) solidMask |= 16;
+		if (block.SideSolid[5]) solidMask |= 32;
+
+		// Stage 2: full cube (all 6 faces solid) — full absorption
+		if (solidMask == 63)
+			return baseAbsorption;
+
+		// Stage 3: volumetric absorber with no solid faces (leaves, water) — full absorption
+		if (solidMask == 0)
+			return baseAbsorption;
+
+		// Stage 4: partial solidity (1–5 solid faces, e.g. slabs, stairs)
+		BlockFacing incoming = dir.Opposite;
+		BlockFacing outgoing = dir;
+
+		bool incomingSolid = (pos != null && readBlockAccess != null)
+			? block.SideIsSolid(readBlockAccess, pos, incoming.Index)
+			: block.SideSolid[incoming.Index];
+
+		if (incomingSolid) return baseAbsorption;
+
+		bool outgoingSolid = (pos != null && readBlockAccess != null)
+			? block.SideIsSolid(readBlockAccess, pos, outgoing.Index)
+			: block.SideSolid[outgoing.Index];
+
+		if (outgoingSolid) return baseAbsorption;
+
+		// Stage 5: edge / opening — light passes through the open part but grazes some material.
+		// At least 50 % is guaranteed to pass; the rest is proportional to baseAbsorption.
+		float clampedAbs = Math.Min(baseAbsorption, 32);
+		return (int)(incomingEnergy * clampedAbs / 64f);
+	}
