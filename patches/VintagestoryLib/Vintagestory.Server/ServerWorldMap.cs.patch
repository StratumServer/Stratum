+	private readonly struct StratumClimateKey : IEquatable<StratumClimateKey>
+	{
+		public readonly int ChunkX;
+		public readonly int ChunkZ;
+		public readonly int Y;
+
+		public StratumClimateKey(int chunkX, int chunkZ, int y)
+		{
+			ChunkX = chunkX;
+			ChunkZ = chunkZ;
+			Y = y;
+		}
+
+		public bool Equals(StratumClimateKey other)
+		{
+			return ChunkX == other.ChunkX && ChunkZ == other.ChunkZ && Y == other.Y;
+		}
+
+		public override bool Equals(object obj)
+		{
+			return obj is StratumClimateKey other && Equals(other);
+		}
+
+		public override int GetHashCode()
+		{
+			return HashCode.Combine(ChunkX, ChunkZ, Y);
+		}
