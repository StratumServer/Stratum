+	private void StratumDispatchQueued(QueuedUDPPacket result, long oldestAllowed)
+	{
+		// Stratum: a null client here is what took the process down under an 800-bot join.
+		if (result?.client == null || result.packet == null)
+		{
+			network.physicsManager.StratumReturnBulkPositionPacket(result?.packet, false);
+			return;
+		}
+		Packet_UdpPacket sending;
+		lock (result)
+		{
+			result.stratumSending = 1;
+			sending = result.packet;
+		}
+		if (sending != null && sending.Id == 5 && sending.EntityPosition != null)
+		{
+			stratumLatestPosition.TryRemove(new System.Collections.Generic.KeyValuePair<(int clientId, long entityId), QueuedUDPPacket>((result.client.Id, sending.EntityPosition.EntityId), result));
+		}
+		if (result.creationTime > oldestAllowed)
+		{
+			try
+			{
+				server.SendPacketBlocking(result.client, sending);
+			}
+			catch (Exception e)
+			{
+				ServerMain.Logger.Error(e);
+			}
+			finally
+			{
+				// Stratum: for the real UDP/TCP-fallback paths, SendPacketBlocking
+				// always finishes reading the packet before returning (serializes
+				// synchronously, no further async handoff), so it's safe to hand it
+				// back to the pool here even if the send itself threw. The
+				// single-player/dummy-network path is different -- see
+				// StratumReturnBulkPositionPacket.
+				network.physicsManager.StratumReturnBulkPositionPacket(sending, result.client.IsSinglePlayerClient);
+			}
+		}
+		else
+		{
+			// Stratum: TTL-dropped packet never reaches SendPacketBlocking, but it's
+			// still safe to recycle (subject to the same single-player exception)
+			// since nothing else holds a reference to it.
+			network.physicsManager.StratumReturnBulkPositionPacket(sending, result.client.IsSinglePlayerClient);
+		}
+	}
