+	[MethodImpl(MethodImplOptions.AggressiveInlining)]
+	private static Vector512<ulong> Transpose8x8_512(Vector512<ulong> x)
+	{
+		Vector512<ulong> t;
+		t = (x ^ (x >> 7)) & Vector512.Create(0x00AA00AA00AA00AAUL);
+		x ^= t ^ (t << 7);
+
+		t = (x ^ (x >> 14)) & Vector512.Create(0x0000CCCC0000CCCCUL);
+		x ^= t ^ (t << 14);
+
+		t = (x ^ (x >> 28)) & Vector512.Create(0x00000000F0F0F0F0UL);
+		x ^= t ^ (t << 28);
+
+		return x;
+	}
